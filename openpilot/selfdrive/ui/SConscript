import json
import os
Import('env', 'qt_env', 'arch', 'common', 'messaging', 'visionipc', 'transformations')

base_libs = [common, messaging, visionipc, transformations,
             'm', 'OpenCL', 'ssl', 'crypto', 'pthread'] + qt_env["LIBS"]

if arch == 'larch64':
  base_libs.append('EGL')

if arch == "Darwin":
  del base_libs[base_libs.index('OpenCL')]
  qt_env['FRAMEWORKS'] += ['OpenCL']

sp_widgets_src = []
sp_qt_src = []
sp_qt_util = []

# stock_ui option may not be defined in 2026; default to False (use sunnypilot Qt UI)
try:
  use_stock_ui = GetOption('stock_ui')
except:
  use_stock_ui = False

if not use_stock_ui:
  SConscript(['sunnypilot/SConscript'])
  Import('sp_widgets_src', 'sp_qt_src', 'sp_qt_util')

qt_util = qt_env.Library("qt_util", ["#openpilot/selfdrive/ui/qt/api.cc", "#openpilot/selfdrive/ui/qt/util.cc"] + sp_qt_util, LIBS=base_libs)

widgets_src = ["qt/widgets/input.cc", "qt/widgets/wifi.cc", "qt/prime_state.cc",
               "qt/widgets/ssh_keys.cc", "qt/widgets/toggle.cc", "qt/widgets/controls.cc",
               "qt/widgets/offroad_alerts.cc", "qt/widgets/prime.cc", "qt/widgets/keyboard.cc",
               "qt/widgets/scrollview.cc", "qt/widgets/cameraview.cc",
               "qt/request_repeater.cc", "qt/qt_window.cc", "qt/network/networking.cc", "qt/network/wifi_manager.cc"] + sp_widgets_src

widgets = qt_env.Library("qt_widgets", widgets_src, LIBS=base_libs)
Export('widgets')
qt_libs = [widgets, qt_util] + base_libs

qt_src = ["main.cc", "ui.cc", "qt/sidebar.cc", "qt/body.cc",
          "qt/window.cc", "qt/home.cc", "qt/offroad/settings.cc", "qt/offroad/offroad_home.cc",
          "qt/offroad/software_settings.cc", "qt/offroad/developer_panel.cc", "qt/offroad/onboarding.cc",
          "qt/offroad/driverview.cc", "qt/offroad/experimental_mode.cc", "qt/offroad/firehose.cc",
          "qt/onroad/onroad_home.cc", "qt/onroad/annotated_camera.cc", "qt/onroad/model.cc",
          "qt/onroad/buttons.cc", "qt/onroad/alerts.cc", "qt/onroad/driver_monitoring.cc", "qt/onroad/hud.cc"] + sp_qt_src

# build translation files
with open(File("#openpilot/selfdrive/ui/translations/languages.json").abspath) as f:
  languages = json.loads(f.read())
translation_sources = [f"#openpilot/selfdrive/ui/translations/{l}.ts" for l in languages.values()]
translation_targets = [src.replace(".ts", ".qm") for src in translation_sources]

# Actually test lrelease by running it. C3 systems commonly have /usr/bin/lrelease
# as a stub that forwards to a missing /usr/lib/qt5/bin/lrelease and fails at runtime.
def _lrelease_works():
  import subprocess
  # Try vendored first (comma CI on larch64)
  vendored = File("#third_party/qt5/larch64/bin/lrelease").abspath
  candidates = [vendored, "/usr/lib/qt5/bin/lrelease", "/usr/bin/lrelease"]
  for c in candidates:
    if not (os.path.exists(c) and os.access(c, os.X_OK)):
      continue
    try:
      # -help exits 0 if lrelease actually works, non-zero if the wrapper stub is broken
      r = subprocess.run([c, "-help"], capture_output=True, timeout=5)
      if r.returncode == 0:
        return c
    except Exception:
      continue
  return None

_lrelease_bin = _lrelease_works()
if _lrelease_bin:
  print(f"SConscript: using lrelease at {_lrelease_bin}")
  lrelease = qt_env.Command(translation_targets, translation_sources, f"{_lrelease_bin} $SOURCES")
else:
  # No working lrelease — emit empty .qm files. Qt logs a warning but does not fail.
  print("SConscript: no working lrelease found — generating empty .qm stubs (UI will show English only)")
  def _make_empty_qm(target, source, env):
    for t in target:
      open(str(t), 'wb').close()
    return None
  lrelease = qt_env.Command(translation_targets, translation_sources, _make_empty_qm)
qt_env.NoClean(translation_sources)
qt_env.Precious(translation_sources)

# create qrc file for compiled translations to include with assets
# NOTE: Removed QRC embedding for translations. main.cc loads .qm files directly
# from the filesystem at applicationDirPath() + "/translations/". The QRC approach
# (using ":/" prefix) was abandoned because it conflicted with the filesystem loading.
# .qm files are built by lrelease (or as empty stubs on C3) and deployed to the
# translations/ directory alongside the ui binary.

# build assets (translations no longer embedded via QRC - loaded from filesystem)
assets = "#openpilot/selfdrive/assets/assets.cc"
assets_src = "#openpilot/selfdrive/assets/assets.qrc"
qt_env.Command(assets, [assets_src], f"rcc $SOURCES -o $TARGET")
# Depend on all files in assets/ recursively so rcc reruns when any icon/SVG changes.
# The default non-recursive Glob missed changes inside icons/, images/, etc.
_asset_deps = []
_asset_root = Dir("#openpilot/selfdrive/assets").abspath
for _root, _dirs, _files in os.walk(_asset_root):
  for _f in _files:
    _p = os.path.join(_root, _f)
    if _p.endswith(('.cc', '.o')) or _p.endswith('.qrc'):
      continue
    _asset_deps.append(File(_p))
qt_env.Depends(assets, _asset_deps + [lrelease] + [File(assets_src)])
asset_obj = qt_env.Object("assets", assets)

# build main UI
qt_env.Program("ui", qt_src + [asset_obj, "#third_party/qrcode/QrCode.cc"], LIBS=qt_libs)

if GetOption('extras'):
  # build installers (raylib)
  if arch != "Darwin":
    raylib_dir = str(env.subst('#openpilot/third_party/raylib'))
    raylib_env = env.Clone()
    raylib_env['LIBPATH'] += [raylib_dir]
    raylib_env['LINKFLAGS'].append('-Wl,-strip-debug')

    raylib_libs = common + ["raylib"]
    if arch == "larch64":
      raylib_libs += ["GLESv2", "wayland-client", "wayland-egl", "EGL"]
    else:
      raylib_libs += ["GL"]

    release = "release3"
    installers = [
      ("openpilot", release),
      ("openpilot_test", f"{release}-staging"),
      ("openpilot_nightly", "nightly"),
      ("openpilot_internal", "nightly-dev"),
    ]

    cont = raylib_env.Command("installer/continue_openpilot.o", "installer/continue_openpilot.sh",
                              "ld -r -b binary -o $TARGET $SOURCE")
    inter = raylib_env.Command("installer/inter_ttf.o", "installer/inter-ascii.ttf",
                               "ld -r -b binary -o $TARGET $SOURCE")
    for name, branch in installers:
      d = {'BRANCH': f"'\"{branch}\"'"}
      if "internal" in name:
        d['INTERNAL'] = "1"

      obj = raylib_env.Object(f"installer/installers/installer_{name}.o", ["installer/installer.cc"], CPPDEFINES=d)
      f = raylib_env.Program(f"installer/installers/installer_{name}", [obj, cont, inter], LIBS=raylib_libs)
      # keep installers small
      assert f[0].get_size() < 1900*1e3, f[0].get_size()
